// Cloudflare (Workers static assets) settings for the frontend.
// Deploy:  VITE_SERVER_URL=https://<backend> npm run build && npx wrangler deploy
{
  "name": "finquiz-live",
  "compatibility_date": "2026-11-13",
  "assets": {
    // The built site. Any unknown path (like /host) is served index.html,
    // so the React app decides which screen to show.
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": true }
}
