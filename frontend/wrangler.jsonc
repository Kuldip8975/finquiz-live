// Cloudflare Pages settings for the frontend (project: finquizlive).
// Deploy:  VITE_SERVER_URL=https://<backend> npm run build && npx wrangler pages deploy
// Any unknown path (like /host) is served index.html because there is no
// 404.html, so the React app decides which screen to show.
{
  "name": "finquizlive",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-11-13"
}
