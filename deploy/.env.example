# Copy to deploy/.env ON THE SERVER and fill in. Never commit the real file.
# setup-ec2.sh fills POSTGRES_PASSWORD with a random value for you.
POSTGRES_PASSWORD=
# The backend's own address (DNS A record pointing at the EC2 Elastic IP)
API_DOMAIN=api.example.com
# The frontend address on Cloudflare Pages (exact origin, no trailing slash)
CORS_ORIGINS=https://your-project.pages.dev
QUESTION_SECONDS=20
